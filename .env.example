# 复制本文件为 .env 并填写实际值。
# systemd 服务通过 EnvironmentFile 读取；也可以把密钥填在 config.yaml 的 primary/ 段。

# ===== 推送通道 =====

# Server酱（微信推送，无需 VPN）—— 推荐必填
SERVERCHAN_SENDKEY=

# 企业微信群机器人 webhook —— 可选
WECOM_WEBHOOK=

# Telegram —— 可选
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy —— 可选
NTFY_TOPIC=

# ===== 情绪/综述 LLM（OpenAI 兼容接口，sentiment.llm 后端与日报综述用）=====
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ===== 可选的一手源密钥（二选一：填这里，或填 config.yaml 的 primary 段）=====
FRED_API_KEY=
QUIVER_TOKEN=
BARGO_BASE_URL=
BARGO_API_KEY=

# Finnhub 免费 key：美股近期新闻回填（免费 tier 约2周），注册 https://finnhub.io/ 免费获取
FINNHUB_API_KEY=
